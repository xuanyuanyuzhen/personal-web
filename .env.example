# Server ports
WEB_PORT=5173
ADMIN_PORT=5174
API_PORT=3000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=yuer
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=yuer
DATABASE_URL=mysql://yuer:change-me@127.0.0.1:3306/yuer

# Initial seed account
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=7d

# Audit
OPERATION_LOG_RETENTION_DAYS=90

# Uploads
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
