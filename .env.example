# Server ports
WEB_PORT=5173
ADMIN_PORT=5174
API_PORT=3000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=yuer
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=yuer
DATABASE_URL=mysql://yuer:change-me@127.0.0.1:3306/yuer

# Initial seed account
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# Auth
# 生产环境必须替换成至少 32 位的随机串，否则 API 拒绝启动。
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=7d

# Cookie
# 生产环境走 HTTPS 时设为 true，让登录 cookie 带上 Secure。
# 不配时回退到按 NODE_ENV 判断。
COOKIE_SECURE=false

# CORS
# 允许携带凭证的跨域来源，逗号分隔，例如 https://example.com,https://admin.example.com
# 留空表示不启用跨域（同源反向代理部署不需要配）。
CORS_ALLOWED_ORIGINS=

# Audit
OPERATION_LOG_RETENTION_DAYS=90

# Uploads
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
